{
  "name": "lyle-rope-kernel",
  "version": "1.1.0-rc.1",
  "description": "Zero-dependency in-place RoPE kernel for JavaScript inference experiments",
  "type": "module",
  "main": "src/rope-kernel.js",
  "exports": {
    ".": "./src/rope-kernel.js",
    "./webgpu": "./src/webgpu-rope.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/NUMERICS.md"
  ],
  "scripts": {
    "test": "node --test",
    "benchmark": "node benchmark.js",
    "benchmark:hot": "node benchmark.js --mode=hot",
    "benchmark:cached": "node benchmark.js --mode=cached",
    "benchmark:qk": "node benchmark-qk.js",
    "test:package": "node scripts/package-smoke.mjs",
    "test:performance": "node --test bench/cached-regression.mjs",
    "verify": "npm test && npm run test:package",
    "evidence": "node scripts/evidence.mjs",
    "example": "node examples/minimal-transformer.js"
  },
  "keywords": [
    "rope",
    "llm",
    "transformer",
    "javascript",
    "inference"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MiMindMendinc/lyle-rope-kernel-js.git"
  },
  "homepage": "https://mimindmendinc.github.io/lyle-rope-kernel-js/",
  "bugs": {
    "url": "https://github.com/MiMindMendinc/lyle-rope-kernel-js/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Lyle Perrien II",
  "license": "MIT"
}
